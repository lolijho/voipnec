# =============================================================================
# AsteriskPanel - Environment Configuration
# =============================================================================
# Copy this file to .env and configure with your values
# cp .env.example .env
# =============================================================================

# ---- Asterisk Connection ----
ASTERISK_HOST=192.168.1.100
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_PASSWORD=supersecret
ASTERISK_ARI_URL=http://192.168.1.100:8088
ASTERISK_ARI_USER=ariuser
ASTERISK_ARI_PASSWORD=arisecret

# ---- Application ----
JWT_SECRET=cambia-questo-segreto
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
CORS_ORIGIN=*

# ---- WebRTC (for browser softphone) ----
VITE_ASTERISK_WS=wss://192.168.1.100:8089/ws

# ---- Trunk: MessageNet ----
MESSAGENET_USERNAME=
MESSAGENET_PASSWORD=
MESSAGENET_DID=

# ---- Trunk: Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TRUNK_SID=
